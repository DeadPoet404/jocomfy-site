# Browser requests use the website's same-origin Next.js API proxy.
NEXT_PUBLIC_SMS_API_URL=/api

# Leave empty until Google OAuth is configured.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Docker-internal SMS backend destination.
SMS_BACKEND_URL=http://backend:5000

# Existing Docker network created by school-management-system.
SMS_DOCKER_NETWORK=school-management-system_sms-net
